{
  "kind": "collectionType",
  "collectionName": "faq_items",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "FAQ Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "blocks"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::faq-category.faq-category"
    },
    "isActive": {
      "type": "boolean"
    },
    "order": {
      "type": "integer"
    },
    "slug": {
      "type": "uid",
      "targetField": "question"
    }
  }
}
