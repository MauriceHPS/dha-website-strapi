{
  "kind": "collectionType",
  "collectionName": "video_testimonials",
  "info": {
    "singularName": "video-testimonial",
    "pluralName": "video-testimonials",
    "displayName": "Video Testimonial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Testimonials",
        "Training",
        "Success Stories",
        "Impact Stories"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "duration": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "location": {
      "type": "string"
    },
    "speaker": {
      "type": "string"
    },
    "rating": {
      "type": "integer"
    },
    "keyPoints": {
      "type": "json"
    },
    "isActive": {
      "type": "boolean"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
