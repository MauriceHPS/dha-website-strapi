{
  "kind": "collectionType",
  "collectionName": "regulatory_documents",
  "info": {
    "singularName": "regulatory-document",
    "pluralName": "regulatory-documents",
    "displayName": "Regulatory Document"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Primary Legislation",
        "Regulations",
        "Guidelines",
        "Standards"
      ]
    },
    "documentStatus": {
      "type": "enumeration",
      "enum": [
        "Enacted",
        "Draft",
        "Under Review",
        "Superseded"
      ]
    },
    "fileSize": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "keyProvisions": {
      "type": "json"
    },
    "document": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "effectiveDate": {
      "type": "date"
    },
    "expiryDate": {
      "type": "date"
    },
    "isActive": {
      "type": "boolean"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
